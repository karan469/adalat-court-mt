# The corpus is not redistributed here: the Drive export is the source of truth,
# and everything under data/ is regenerated by scripts/01_build_corpus.py.
# reports/ does carry the 120 test sentence pairs, which the qualitative
# evaluation quotes and which make the reported scores checkable.
data/
!data/.gitkeep

# Rebuilt from the tree by the command in kaggle/KAGGLE_SETUP.md; it packages
# data/processed/, so it is not committed for the same reason data/ is not.
kaggle/*.zip

# Trained SentencePiece models are regenerated by notebook 3. The extended
# tokenizer chosen for Task 3 is committed, since it is a result rather than an
# intermediate.
artifacts/spm/
artifacts/runs/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# model weights, large and re-downloadable
models/
*.safetensors
*.bin
*.pt

# caches
.cache/
.pytest_cache/
.ruff_cache/

# os and editor
.DS_Store
.vscode/
.idea/
